@insert_zone declarations
#ifndef SILKY_WORLD_TWEAKS_FOG_UNIFORMS_DECLARED
#define SILKY_WORLD_TWEAKS_FOG_UNIFORMS_DECLARED
uniform bool silkyWorldTweaksFogControl;
uniform bool silkyWorldTweaksFogModify;
uniform float silkyWorldTweaksFogStart;
uniform float silkyWorldTweaksFogEnd;
uniform vec3 silkyWorldTweaksFogColor;
uniform int silkyWorldTweaksFogDisableMask;
#endif

#ifndef SILKY_FULLBRIGHT_UNIFORMS_DECLARED
#define SILKY_FULLBRIGHT_UNIFORMS_DECLARED
uniform bool silkyFullbrightEnabled;
uniform float silkyFullbrightMinLight;
uniform float silkyOverrideAmbientLight;
#endif

float silkyComposite1FogAmount(float distanceToCamera, float sceneDepth) {
    float silkyFogRange = max(silkyWorldTweaksFogEnd - silkyWorldTweaksFogStart, 1.0);
    float silkyFog = smoothstep(0.0, 1.0, clamp((distanceToCamera - silkyWorldTweaksFogStart) / silkyFogRange, 0.0, 1.0));
    if (sceneDepth >= 0.999999) silkyFog *= 0.16;
    return silkyFog;
}

void silkyComposite1ApplyFog(inout vec3 value, float distanceToCamera, float sceneDepth) {
    value = mix(value, silkyWorldTweaksFogColor, silkyComposite1FogAmount(distanceToCamera, sceneDepth));
}
@end

@insert_before_ident screenPos1 1
    if (silkyWorldTweaksFogControl && silkyWorldTweaksFogModify && isEyeInWater != 1 && z0 != z1) {
        silkyComposite1ApplyFog(color, lViewPos, z0); // silkyComposite1TranslucentFog
    }

@end

@insert_after_hash 76c77fdbcc40f9aa86445f791963258aff2e988af8357d2ef56eff81e2e5ef3c 3
        float silkyUnderwaterFullbright = max(
            silkyFullbrightEnabled ? clamp(silkyFullbrightMinLight, 0.0, 1.0) : 0.0,
            clamp(silkyOverrideAmbientLight, 0.0, 1.0)
        );
        bool silkyCustomUnderwaterFog = silkyWorldTweaksFogControl && silkyWorldTweaksFogModify;
        bool silkyDisableUnderwaterFog = silkyWorldTweaksFogControl && (silkyWorldTweaksFogDisableMask & 1) != 0;
        vec3 silkyUnderwaterBaseMult = vec3(0.97, 0.985, 1.0);
        vec3 silkyUnderwaterMult = mix(silkyUnderwaterBaseMult * 0.98, vec3(1.0), silkyUnderwaterFullbright);

        if (silkyCustomUnderwaterFog) {
            silkyComposite1ApplyFog(color, lViewPos, z0);
        } else if (!silkyDisableUnderwaterFog) {
            if (z0 == 1.0) {
                float silkyUnderwaterFogTint = 0.08 * (1.0 - silkyUnderwaterFullbright);
                color.rgb = mix(color.rgb, waterFogColor, silkyUnderwaterFogTint);
            }
            color.rgb *= silkyUnderwaterMult;
            volumetricEffect.rgb *= mix(vec3(0.94), vec3(1.0), silkyUnderwaterFullbright);
        }
@end


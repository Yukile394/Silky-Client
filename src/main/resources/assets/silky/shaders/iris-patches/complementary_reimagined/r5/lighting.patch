#ifndef SILKY_FULLBRIGHT_UNIFORMS_DECLARED
#define SILKY_FULLBRIGHT_UNIFORMS_DECLARED
uniform bool silkyFullbrightEnabled;
uniform float silkyFullbrightMinLight;
uniform float silkyOverrideAmbientLight;
#endif


@insert_after_function_open DoLighting
    float silkyFullbrightStrength = silkyFullbrightEnabled ? clamp(silkyFullbrightMinLight, 0.0, 1.0) : 0.0;
    float silkyAmbientOverrideStrength = clamp(silkyOverrideAmbientLight, 0.0, 1.0);
    float silkyEffectiveLightStrength = max(silkyFullbrightStrength, silkyAmbientOverrideStrength);
    if (silkyEffectiveLightStrength > 0.0) {
        lightmap = max(lightmap, vec2(silkyEffectiveLightStrength));
    }

@end


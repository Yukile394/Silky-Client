#ifndef SILKY_WORLD_TWEAKS_FOG_UNIFORMS_DECLARED
#define SILKY_WORLD_TWEAKS_FOG_UNIFORMS_DECLARED
uniform bool silkyWorldTweaksFogControl;
uniform bool silkyWorldTweaksFogModify;
uniform float silkyWorldTweaksFogStart;
uniform float silkyWorldTweaksFogEnd;
uniform vec3 silkyWorldTweaksFogColor;
uniform int silkyWorldTweaksFogDisableMask;
#endif

float silkyPhotonWorldTweaksFogAmount(float distanceToCamera, bool sky) {
    float fogRange = max(silkyWorldTweaksFogEnd - silkyWorldTweaksFogStart, 1.0);
    float fogDistance = min(distanceToCamera, silkyWorldTweaksFogEnd);
    float fog = smoothstep(0.0, 1.0, clamp((fogDistance - silkyWorldTweaksFogStart) / fogRange, 0.0, 1.0));
    if (sky) fog *= 0.16;
    return fog;
}

void silkyPhotonApplyWorldTweaksFog(inout vec3 color, float distanceToCamera, bool sky) {
    color = mix(color, silkyWorldTweaksFogColor, silkyPhotonWorldTweaksFogAmount(distanceToCamera, sky));
} // silkyPhotonApplyWorldTweaksFog
@end

@insert_after_hash be5ef0bea5057e7d62bad71bec7721dc0048bffd6e941be27511a801bbe48a0a
    if (silkyWorldTweaksFogControl && silkyWorldTweaksFogModify) {
        silkyPhotonApplyWorldTweaksFog(fragment_color, view_distance, is_sky);
    }

@end
